# انسخ هذا الملف إلى .env وضع قيمك (ملف .env لا يُرفع إلى GitHub).
# كل هذه القيم يمكن أيضاً إدخالها من صفحة "الإعدادات" في الواجهة (تُحفظ في data/settings.json).

# --- الخادم ---
PORT=3000
# HOST=0.0.0.0           # للتشغيل على سيرفر عام (يتطلب ADMIN_PASSWORD)
# ADMIN_PASSWORD=        # كلمة مرور لوحة التحكم

# --- Supabase (حسابك) ---
SUPABASE_ACCESS_TOKEN=   # يبدأ بـ sbp_
SUPABASE_PROJECT_REF=    # 20 حرف، مثل abcdefghijklmnopqrst

# --- Firebase ---
FIREBASE_DB_URL=         # https://xxxx-default-rtdb.firebaseio.com
FIREBASE_API_KEY=        # اختياري — يبدأ بـ AIza

# --- GitHub (البناء) ---
GITHUB_TOKEN=            # يبدأ بـ ghp_ أو github_pat_ (الصلاحيات: repo + workflow)
GITHUB_REPO=apk-app
# GITHUB_PRIVATE=false   # افتراضياً المستودع خاص

# --- الذكاء الاصطناعي ---
GEMINI_API_KEY=          # يبدأ بـ AIza
GEMINI_API_KEY_2=        # اختياري — من مشروع آخر
GEMINI_API_KEY_3=        # اختياري — من مشروع آخر
GEMINI_MODEL=            # فارغ = gemini-2.5-flash
ANTHROPIC_API_KEY=       # مفتاح Claude — يبدأ بـ sk-ant-
CLAUDE_MODEL=            # فارغ = claude-opus-5-5
OPENROUTER_API_KEY=      # يبدأ بـ sk-or-
OPENROUTER_MODEL=        # مثال: openai/gpt-oss-120b:free
GROQ_API_KEY=            # يبدأ بـ gsk_
GROQ_MODEL=              # اختياري: openai/gpt-oss-120b
AI_ORDER=gemini,claude,openrouter,groq

# --- البريد ---
MAIL_PROVIDER=gmail      # gmail أو brevo
GMAIL_USER=              # you@gmail.com
GMAIL_APP_PASSWORD=      # 16 حرف: xxxx xxxx xxxx xxxx
BREVO_LOGIN=             # xxxx@smtp-brevo.com
BREVO_SENDER=            # إيميل متحقق منه في Brevo ← Senders
BREVO_SMTP_KEY=          # يبدأ بـ xsmtpsib-
